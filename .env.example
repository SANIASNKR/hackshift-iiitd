# This configuration is for a local synthetic-data demonstration only.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./ayustream.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_BEFORE_NONLOCAL_DEPLOYMENT
JWT_EXPIRE_MINUTES=480
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=15
HOSPITAL_STATUS_TTL_SECONDS=1800
HOSPITAL_STALE_MINUTES=30
ACCEPTANCE_TIMEOUT_SECONDS=120
